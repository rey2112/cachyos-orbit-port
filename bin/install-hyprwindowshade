#!/usr/bin/env bash

set -euo pipefail

repo_url="https://github.com/ManofJELLO/HyprWindowShade.git"
repo_commit="40b756befa36cfd5cbed65d554c719141a65c420"
source_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hyprwindowshade/$repo_commit"
patch_file="$HOME/.config/hypr/patches/hyprwindowshade-per-window-effects.patch"

command -v git >/dev/null || { printf '%s\n' 'error: git is required' >&2; exit 1; }
command -v g++ >/dev/null || { printf '%s\n' 'error: g++ is required' >&2; exit 1; }

# Header source, in order: an explicit ORBIT_HYPRLAND_HEADERS root, the hyprpm
# header cache (populated by `hyprpm update`), then the system headers that the
# distribution's hyprland package exposes through pkg-config (Arch/CachyOS).
headers="${ORBIT_HYPRLAND_HEADERS:-/var/cache/hyprpm/$USER/headersRoot}"
header_flags=()
if [[ -d "$headers/include/hyprland/src" ]]; then
    header_flags=(
        -I"$headers/include"
        -I"$headers/include/hyprland"
        -I"$headers/include/hyprland/src"
        -I"$headers/include/hyprland/protocols"
    )
    version_header="$headers/include/hyprland/src/version.h"
elif command -v pkg-config >/dev/null && pkg-config --exists hyprland; then
    read -r -a header_flags <<<"$(pkg-config --cflags hyprland)"
    version_header="$(pkg-config --variable=prefix hyprland)/hyprland/src/version.h"
else
    printf '%s\n' 'error: no Hyprland headers found; install the hyprland development headers or run `hyprpm update`' >&2
    exit 1
fi
if [[ -f "$version_header" ]] && command -v hyprctl >/dev/null; then
    header_commit=$(sed -n 's/.*GIT_COMMIT_HASH[[:space:]]*"\([0-9a-f]*\)".*/\1/p' "$version_header" | head -n1)
    running_commit=$(hyprctl version -j 2>/dev/null | sed -n 's/.*"commit":[[:space:]]*"\([0-9a-f]*\)".*/\1/p' | head -n1 || true)
    if [[ -n "$header_commit" && -n "$running_commit" && "$header_commit" != "$running_commit" ]]; then
        printf 'warning: Hyprland headers are %s but the running compositor is %s\n' "$header_commit" "$running_commit" >&2
    fi
fi

if [[ ! -d "$source_dir/.git" ]]; then
    mkdir -p "${source_dir%/*}"
    git clone --filter=blob:none "$repo_url" "$source_dir"
fi

git -C "$source_dir" fetch --quiet --depth=1 origin "$repo_commit"
git -C "$source_dir" checkout --quiet --detach "$repo_commit"
git -C "$source_dir" reset --quiet --hard "$repo_commit"
git -C "$source_dir" apply "$patch_file"

plugin_dir="$HOME/.local/share/hyprland/plugins"
plugin_path="$plugin_dir/HyprWindowShade.so"
mkdir -p "$plugin_dir"
(
    cd "$source_dir"
    g++ -shared -fPIC -O3 -std=c++23 *.cpp -o HyprWindowShade.so \
        "${header_flags[@]}" \
        -I/usr/include/cairo \
        -I/usr/include/freetype2 \
        -I/usr/include/libpng16 \
        -I/usr/include/pixman-1 \
        -I/usr/include/libdrm \
        -lGLESv2 -lEGL -lGL
    install -m 0755 HyprWindowShade.so "$plugin_path"
)
printf '%s\n' "Installed $plugin_path for the next Hyprland session; the running compositor was not touched."
