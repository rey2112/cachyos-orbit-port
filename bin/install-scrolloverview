#!/usr/bin/env bash

set -euo pipefail

repo_url="https://github.com/yayuuu/hyprland-scroll-overview.git"
repo_commit="f9248ab6bee770e9d68813b48cc6ca12b3271254"
reference_hyprland="efb50993780079460b0cbed1363e2166a2de1d9f"
source_dir="${ORBIT_PLUGIN_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/orbit-hyprland-plugins}/scrolloverview-$repo_commit"
plugin_dir="${ORBIT_PLUGIN_DIR:-$HOME/.local/share/hyprland/plugins}"

command -v git >/dev/null || { printf '%s\n' 'error: git is required' >&2; exit 1; }
command -v make >/dev/null || { printf '%s\n' 'error: make is required' >&2; exit 1; }
command -v g++ >/dev/null || { printf '%s\n' 'error: g++ is required' >&2; exit 1; }
command -v pkg-config >/dev/null || { printf '%s\n' 'error: pkg-config is required' >&2; exit 1; }

for package in hyprland pixman-1 libdrm pangocairo libinput libudev wayland-server xkbcommon; do
    pkg-config --exists "$package" || {
        printf 'error: required development package is unavailable: %s\n' "$package" >&2
        exit 1
    }
done
# ScrollOverview calls the Lua C API on Hyprland's own lua_State, so it must be
# compiled against the Lua that Hyprland links. Upstream Hyprland 0.56 links
# Lua 5.5 (Arch), but Fedora's build links the system Lua 5.4, so read the
# version from the Hyprland binary and fall back to 5.5. Upstream's Makefile
# prefers lua5.4 when present, so the package is always passed explicitly.
lua_version=5.5
hyprland_binary=$(command -v Hyprland || command -v hyprland || true)
if [[ -n "$hyprland_binary" ]]; then
    linked=$(ldd "$hyprland_binary" 2>/dev/null | grep -oE 'liblua-?[0-9]\.?[0-9]' | head -n1 | grep -oE '[0-9]\.?[0-9]$' || true)
    [[ "$linked" =~ ^([0-9])\.?([0-9])$ ]] && lua_version="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
fi
lua_next="${lua_version%.*}.$(( ${lua_version#*.} + 1 ))"
lua_pkg=''
for candidate in "lua${lua_version/./}" "lua${lua_version}" "lua-${lua_version/./}" "lua-${lua_version}"; do
    if pkg-config --exists "$candidate"; then lua_pkg="$candidate"; break; fi
done
if [[ -z "$lua_pkg" ]] && pkg-config --exists "lua >= $lua_version" && pkg-config --exists "lua < $lua_next"; then
    lua_pkg=lua
fi
[[ -n "$lua_pkg" ]] || {
    printf 'error: Lua %s development package is unavailable (Hyprland links Lua %s)\n' "$lua_version" "$lua_version" >&2
    exit 1
}
printf 'building against %s (Hyprland links Lua %s)\n' "$lua_pkg" "$lua_version"

if command -v hyprctl >/dev/null && command -v python3 >/dev/null; then
    running_commit=$(hyprctl version -j 2>/dev/null | python3 -c 'import json, sys; print(json.load(sys.stdin).get("commit", ""))' || true)
    if [[ -n "$running_commit" && "$running_commit" != "$reference_hyprland" ]]; then
        printf 'warning: building ScrollOverview for Hyprland ABI %s, not validated reference %s\n' "$running_commit" "$reference_hyprland" >&2
    fi
else
    printf '%s\n' 'warning: hyprctl/python3 unavailable; Hyprland ABI was not inspected' >&2
fi

if [[ ! -d "$source_dir/.git" ]]; then
    mkdir -p "${source_dir%/*}"
    git clone --filter=blob:none "$repo_url" "$source_dir"
fi

git -C "$source_dir" fetch --quiet --depth=1 origin "$repo_commit"
git -C "$source_dir" checkout --quiet --detach "$repo_commit"
git -C "$source_dir" reset --quiet --hard "$repo_commit"
[[ "$(git -C "$source_dir" rev-parse HEAD)" == "$repo_commit" ]] || {
    printf '%s\n' 'error: ScrollOverview checkout did not reach the pinned commit' >&2
    exit 1
}

(
    cd "$source_dir"
    make clean >/dev/null 2>&1 || true
    make all LUA_PKG="$lua_pkg"
    mkdir -p "$plugin_dir"
    install -m 0755 scrolloverview.so "$plugin_dir/libscrolloverview.so"
)
printf '%s\n' "Installed $plugin_dir/libscrolloverview.so for the next Hyprland session; the running compositor was not touched."
