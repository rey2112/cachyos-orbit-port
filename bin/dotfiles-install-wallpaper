#!/usr/bin/env bash
set -euo pipefail

repo_url="${ORBIT_WALLPAPER_REPO_URL:-git@github.com:CleanShirtUK/orbit-wallpaper-engine.git}"
repo_dir="${ORBIT_WALLPAPER_REPO_DIR:-$HOME/.local/src/orbit-wallpaper-engine}"
ref="${ORBIT_WALLPAPER_REF:-v0.2.0}"

install_external_file() {
    local source="$1" destination="$2" mode="$3"
    if [[ -e "$destination" || -L "$destination" ]]; then
        cmp -s "$source" "$destination" || {
            printf 'refusing to replace unrelated Wallpaper Engine integration file: %s\n' "$destination" >&2
            return 1
        }
        return 0
    fi
    install -D -m "$mode" "$source" "$destination"
}

install_noctalia_integration() {
    local plugin_source="$repo_dir/integrations/noctalia"
    [[ -f "$plugin_source/plugin.toml" && -f "$plugin_source/widget.luau" ]] || {
        printf 'Wallpaper Engine Noctalia integration is missing from %s\n' "$repo_dir" >&2
        return 1
    }
    install_external_file "$repo_dir/tools/orbit-wallpaper-settings" \
        "$HOME/.local/bin/orbit-wallpaper-settings" 0755
    # The settings launcher above opens these Quickshell files; without them it
    # exits with "settings UI is not installed" and no window appears.
    local qml
    for qml in WallpaperSettings.qml StandaloneSettings.qml; do
        install_external_file "$repo_dir/settings/$qml" \
            "${XDG_DATA_HOME:-$HOME/.local/share}/orbit-wallpaper-engine/settings/$qml" 0644
    done
    install_external_file "$plugin_source/plugin.toml" \
        "$HOME/.local/share/noctalia/plugins/orbit-wallpaper-engine/plugin.toml" 0644
    install_external_file "$plugin_source/widget.luau" \
        "$HOME/.local/share/noctalia/plugins/orbit-wallpaper-engine/widget.luau" 0644
}

if [[ -d "$repo_dir/.git" ]]; then
    git -C "$repo_dir" fetch --tags origin
else
    mkdir -p "$(dirname "$repo_dir")"
    git clone "$repo_url" "$repo_dir"
fi

git -C "$repo_dir" fetch --tags origin
git -C "$repo_dir" checkout "$ref"
make -C "$repo_dir"
install_noctalia_integration
# The renderer reads its default shader from the data dir (the external
# `make install` step, whose binary and service Orbit supplies itself).
install_external_file "$repo_dir/wave.frag" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/orbit-wallpaper-engine/wave.frag" 0644
mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/orbit-wallpaper-engine/shaders"
# The routed launcher and its desktop entry are Orbit-owned (the external
# v0.2.0 tree has no bin/orbit-wallpaper-launcher). bootstrap/deploy normally
# links/seeds them already; install them only when absent.
orbit_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
install_external_file "$orbit_dir/bin/orbit-wallpaper-launcher" \
    "$HOME/.local/bin/orbit-wallpaper-launcher" 0755
install_external_file "$orbit_dir/desktop/orbit-wallpaper-engine-settings.desktop" \
    "$HOME/.local/share/applications/orbit-wallpaper-engine-settings.desktop" 0644

systemctl --user daemon-reload
systemctl --user enable --now orbit-wallpaper-engine.service
