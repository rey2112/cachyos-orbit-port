#!/usr/bin/env bash
set -euo pipefail

readonly zone='public'
readonly port='53317'

if ! command -v firewall-cmd >/dev/null 2>&1; then
    # Arch/CachyOS commonly use ufw instead of firewalld.
    if command -v ufw >/dev/null 2>&1; then
        sudo ufw allow "$port/tcp" comment LocalSend
        sudo ufw allow "$port/udp" comment LocalSend
        sudo ufw status | grep -F "$port" || true
        exit 0
    fi
    printf 'Neither firewall-cmd nor ufw was found. Install firewalld or ufw first.\n' >&2
    exit 1
fi

sudo -v

if ! firewall-cmd --state >/dev/null 2>&1; then
    printf 'Starting and enabling firewalld...\n'
    sudo systemctl enable --now firewalld.service
fi

sudo firewall-cmd --permanent --zone="$zone" --add-port="$port/tcp"
sudo firewall-cmd --permanent --zone="$zone" --add-port="$port/udp"
sudo firewall-cmd --reload

printf 'LocalSend firewall rules in zone %s:\n' "$zone"
sudo firewall-cmd --zone="$zone" --list-ports
