#!/usr/bin/env bash
# Install end-4's illogical-impulse Quickshell shell for Orbit (UNTESTED).
#
#   bin/install-end4-shell [--skip-deps]
#
# end-4's own installer handles dependencies and system setup only
# (--skip-allfiles): its file step mirrors whole directories with --delete and
# would remove Orbit's links. This script places the shell and its matugen
# templates itself, selects the shell with orbit-desktop-shell, and redeploys Orbit.
# Switch back any time with `orbit-desktop-shell set noctalia` and a new login.
set -euo pipefail

repo_url="https://github.com/end-4/dots-hyprland.git"
repo_commit="2f2a376fdb2ad738bf55f693dd0b474b64bb0ab8"
source_dir="${ORBIT_END4_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/orbit-end4/dots-hyprland}"
config="${XDG_CONFIG_HOME:-$HOME/.config}"
orbit_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
backup_dir="$HOME/orbit-backup-end4-$(date +%Y%m%dT%H%M%S)"
skip_deps=false
case "${1:-}" in
    --skip-deps) skip_deps=true ;;
    '') ;;
    *) printf 'usage: %s [--skip-deps]\n' "$0" >&2; exit 2 ;;
esac

move_aside() {
    local path="$1"
    [[ -e "$path" || -L "$path" ]] || return 0
    mkdir -p "$backup_dir/$(dirname "${path#"$HOME"/}")"
    mv -- "$path" "$backup_dir/${path#"$HOME"/}"
    printf 'moved aside: %s -> %s\n' "$path" "$backup_dir/${path#"$HOME"/}"
}

command -v git >/dev/null || { printf 'error: git is required\n' >&2; exit 1; }

# end-4's setup inspects git history, so keep a full clone at the pinned commit.
if [[ ! -d "$source_dir/.git" ]]; then
    mkdir -p "${source_dir%/*}"
    git clone "$repo_url" "$source_dir"
fi
git -C "$source_dir" fetch --quiet origin
git -C "$source_dir" checkout --quiet --detach "$repo_commit"
[[ "$(git -C "$source_dir" rev-parse HEAD)" == "$repo_commit" ]] || {
    printf 'error: end-4 checkout did not reach the pinned commit\n' >&2
    exit 1
}

if [[ "$skip_deps" == false ]]; then
    # Dependencies (illogical-impulse-* packages, including its pinned
    # quickshell-git, which replaces Arch's quickshell), Python venv, groups.
    # end-4 installs with --noconfirm, which declines conflict removals and
    # aborts. Remove the two conflicting packages its replacements provide.
    for pair in quickshell:illogical-impulse-quickshell-git adw-gtk-theme:adw-gtk-theme-git; do
        old=${pair%%:*} new=${pair#*:}
        if pacman -Qq "$old" >/dev/null 2>&1 && ! pacman -Qq "$new" >/dev/null 2>&1; then
            printf 'Removing %s; end-4 replaces it with %s\n' "$old" "$new"
            sudo pacman -Rdd --noconfirm "$old"
        fi
    done
    (cd "$source_dir" && ./setup install --skip-allfiles --skip-sysupdate --skip-plasmaintg)
fi

# Shell files. Only ~/.config/quickshell/ii is replaced; Orbit's global-menu
# links beside it are left alone.
if [[ -e "$config/quickshell/ii" ]]; then move_aside "$config/quickshell/ii"; fi
mkdir -p "$config/quickshell"
cp -a "$source_dir/dots/.config/quickshell/ii" "$config/quickshell/ii"
install -D -m 0644 "$source_dir/dots/.local/share/icons/illogical-impulse.svg" \
    "$HOME/.local/share/icons/illogical-impulse.svg"

# matugen templates are copied without deleting, so Orbit's templates/orbit
# links survive. Orbit's own matugen config replaces end-4's.
mkdir -p "$config/matugen/templates"
cp -a "$source_dir/dots/.config/matugen/templates/." "$config/matugen/templates/"
if [[ -e "$config/matugen/config.toml" && ! -L "$config/matugen/config.toml" ]]; then
    move_aside "$config/matugen/config.toml"
fi

# Orbit's animated wallpaper replaces end-4's image wallpaper. An empty path
# keeps end-4's background layer transparent.
shell_config="$config/illogical-impulse/config.json"
if [[ -f "$shell_config" ]] && command -v jq >/dev/null; then
    jq '.background.wallpaperPath = "" | .background.thumbnailPath = ""' "$shell_config" > "$shell_config.tmp"
    mv "$shell_config.tmp" "$shell_config"
fi

"$orbit_dir/bin/orbit-desktop-shell" set ii
"$orbit_dir/bootstrap/deploy"
printf '%s\n' "end-4 shell installed at $repo_commit. Log out and back in to start it." \
    "Switch back with: orbit-desktop-shell set noctalia (then log out and back in)."
[[ -d "$backup_dir" ]] && printf 'Replaced files were moved to %s\n' "$backup_dir"
exit 0
