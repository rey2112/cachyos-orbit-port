#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
home_dir=${HOME:?HOME is required}
optional=false
[[ "${1:-}" == "--optional" ]] && optional=true
[[ $# -le 1 ]] || { printf 'usage: %s [--optional]\n' "$0" >&2; exit 2; }

link_owned() {
    local source="$1" destination="$2"
    mkdir -p "$(dirname "$destination")"
    if [[ -L "$destination" ]]; then
        [[ "$(readlink -f "$destination")" == "$(readlink -f "$source")" ]] || {
            printf 'refusing to replace unrelated symlink: %s\n' "$destination" >&2
            exit 1
        }
        return
    fi
    [[ ! -e "$destination" ]] || {
        printf 'refusing to overwrite existing file: %s\n' "$destination" >&2
        exit 1
    }
    ln -s "$source" "$destination"
}

seed_file() {
    local source="$1" destination="$2"
    mkdir -p "$(dirname "$destination")"
    if [[ ! -e "$destination" ]]; then
        install -m 0644 "$source" "$destination"
    fi
}

verify_file() {
    local source="$1" destination="$2"
    [[ -f "$destination" ]] && cmp -s "$source" "$destination" || {
        printf 'missing or incorrect deployed file: %s\n' "$destination" >&2
        exit 1
    }
}

install_sound_theme() {
    local source="$repo_dir/assets/sounds/Orbit" destination="$home_dir/.local/share/sounds/Orbit"
    mkdir -p "$destination/stereo"
    if [[ ! -e "$destination/index.theme" ]]; then
        install -m 0644 "$source/index.theme" "$destination/index.theme"
    fi
    for file in "$source/stereo"/*.wav; do
        [[ -f "$file" ]] || continue
        if [[ ! -e "$destination/stereo/$(basename "$file")" ]]; then
            install -m 0644 "$file" "$destination/stereo/"
        fi
    done
}

# orbit-theme replaces these links with generated regular files; a later
# deploy keeps the generated file instead of refusing it.
generated_outputs=" hypr/hyprqt6engine.conf wezterm/wezterm.lua "

link_config() {
    local relative="$1" destination="$home_dir/.config/$1"
    if [[ "$generated_outputs" == *" $relative "* && -f "$destination" && ! -L "$destination" ]]; then
        return
    fi
    link_owned "$repo_dir/config/$relative" "$home_dir/.config/$relative"
}

# The relative globs below (hypr/scripts/*, quickshell/global-menu/*, ...)
# must expand inside config/, not the caller's working directory.
cd "$repo_dir/config"
for relative in \
    hypr/hyprland.lua hypr/hypridle.conf hypr/hyprlock.conf \
    hypr/hyprqt6engine.conf hypr/hyprtoolkit.conf hypr/appearance.toml \
    hypr/scrolloverview.lua hypr/laptop.lua; do
    link_config "$relative"
done
for relative in hypr/scripts/* hypr/shaders/* hypr/patches/*; do
    link_config "$relative"
done
# fastfetch is optional user configuration: link Orbit's only when the user
# has none, and say so instead of failing when one already exists.
if [[ -e "$home_dir/.config/fastfetch/config.jsonc" && ! -L "$home_dir/.config/fastfetch/config.jsonc" ]]; then
    printf 'keeping your fastfetch config; the Orbit one is %s\n' "$repo_dir/config/fastfetch/config.jsonc"
else
    link_config fastfetch/config.jsonc
fi
for relative in noctalia/90-orbit-glass.toml noctalia/hooks.toml noctalia/orbit-templates.toml noctalia/orbit-wallpaper.toml \
    noctalia/orbit-bar.toml noctalia/orbit-shell.toml noctalia/orbit-colors.toml \
    noctalia/templates/wallpaper-palette.lua noctalia/palettes/Orbit-Mono.json; do
    link_config "$relative"
done
for relative in quickshell/global-menu/* gtk-3.0/gtk.css \
    gtk-3.0/gtk3-presentation.css gtk-3.0/shadow-overrides.css \
    gtk-4.0/gtk.css gtk-4.0/gtk-dark.css gtk-4.0/nautilus-overrides.css \
    gtk-4.0/shadow-overrides.css kitty/kitty.conf wezterm/wezterm.lua \
    wezterm/orbit-about.lua zed/settings.json zed/themes/noctalia.json \
    zen/orbit-userChrome.css obsidian/orbit-appearance.css \
    actions-for-nautilus/config.json; do
    link_config "$relative"
done

seed_file "$repo_dir/config/qt6ct/qt6ct.conf" "$home_dir/.config/qt6ct/qt6ct.conf"
seed_file "$repo_dir/desktop/orbit-wallpaper-engine-settings.desktop" \
    "$home_dir/.local/share/applications/orbit-wallpaper-engine-settings.desktop"
seed_file "$repo_dir/desktop/orbit-wallpaper-mode.desktop" \
    "$home_dir/.local/share/applications/orbit-wallpaper-mode.desktop"
install_sound_theme

for source in "$repo_dir/bin"/*; do
    [[ -f "$source" ]] || continue
    link_owned "$source" "$home_dir/.local/bin/$(basename "$source")"
done
for source in "$repo_dir/lib"/*; do
    [[ -f "$source" ]] || continue
    link_owned "$source" "$home_dir/.local/lib/$(basename "$source")"
done
for source in "$repo_dir/systemd/user"/*.service "$repo_dir/systemd/user"/*.timer "$repo_dir/systemd/user"/*.target; do
    [[ -f "$source" ]] || continue
    link_owned "$source" "$home_dir/.config/systemd/user/$(basename "$source")"
done
for directory in hypridle.service.d app-dev.lizardbyte.app.Sunshine.service.d; do
    for source in "$repo_dir/systemd/user/$directory"/*; do
        [[ -f "$source" ]] || continue
        link_owned "$source" "$home_dir/.config/systemd/user/$directory/$(basename "$source")"
    done
done

if [[ "$optional" == true ]]; then
    systemctl --user enable orbit-game-session.timer localsend.service
fi
systemctl --user daemon-reload
# orbit-wallpaper-mode static keeps the engine disabled; respect that choice.
if [[ "$(cat "$home_dir/.config/orbit/wallpaper-mode" 2>/dev/null)" != static ]]; then
    systemctl --user enable orbit-wallpaper-engine.service
fi
systemctl --user enable workspace-alt-tab-input.service \
    workspace-alt-tab-release.service new-workspace-apps.service \
    window-shader-events.service hypridle.service hyprpolkitagent.service

command -v noctalia >/dev/null 2>&1 || {
    printf 'Noctalia is required before generated appearance outputs can be refreshed.\n' >&2
    exit 1
}
noctalia msg templates-apply >/dev/null
"$home_dir/.local/bin/orbit-update-all-colors" noctalia
printf 'Orbit source deployment prepared from %s\n' "$repo_dir"
