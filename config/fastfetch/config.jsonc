// Orbit fastfetch (asahi branch): small Fedora logo, monochrome, no colour
// blocks. White logo and values, grey labels.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "fedora_small",
    "color": { "1": "white", "2": "white" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "",
    "color": { "keys": "90", "title": "white", "output": "white", "separator": "90" },
    "key": { "width": 10 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[90m────────────────────" },
    { "type": "os", "key": "os", "format": "{pretty-name}" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "cpu", "key": "cpu", "format": "{name}" },
    { "type": "gpu", "key": "gpu", "format": "{name}" },
    { "type": "memory", "key": "ram", "format": "{used} / {total}" },
    { "type": "packages", "key": "packages", "format": "{all}" }
  ]
}
