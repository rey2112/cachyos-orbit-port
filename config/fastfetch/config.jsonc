// Orbit fastfetch: small CachyOS logo and a short system summary.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "cachyos_small",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta" },
    "key": { "width": 10 }
  },
  "modules": [
    "break",
    { "type": "kernel", "key": "kernel" },
    { "type": "cpu", "key": "cpu", "showPeCoreCount": false },
    { "type": "gpu", "key": "gpu", "hideType": "integrated" },
    { "type": "memory", "key": "ram" },
    { "type": "packages", "key": "packages" },
    "break",
    "colors"
  ]
}
