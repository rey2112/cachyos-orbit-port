+// ── Hook-free layer glass ────────────────────────────────────────────────────
+// Hyprland's function hooks exist only on x86-64, so on other architectures
+// (Apple Silicon under Asahi) renderLayer cannot be hooked. Instead, at
+// RENDER_LAST_MOMENT (every element of the frame is queued, nothing is drawn
+// yet) wrap each glassed layer's surface elements in the main render pass
+// with the same pre/post elements the hook adds around renderLayer().
+namespace {
+    // CRenderPass::m_passElements is private; an explicit instantiation may
+    // name it, and the friend hands back the member pointer.
+    struct SPassElementsTag {};
+    template <typename Tag, auto Member>
+    struct SPrivateAccess {
+        friend constexpr auto privateMember(Tag) {
+            return Member;
+        }
+    };
+    constexpr auto privateMember(SPassElementsTag);
+    template struct SPrivateAccess<SPassElementsTag, &Render::CRenderPass::m_passElements>;
+}
+
+// The layer a main (non-popup) layer-surface element belongs to, else null.
+static PHLLS layerOfElement(const UP<IPassElement>& element) {
+    if (!element || element->type() != EK_SURFACE)
+        return nullptr;
+    auto* surface = dynamic_cast<CSurfacePassElement*>(element.get());
+    if (!surface || surface->m_data.popup)
+        return nullptr;
+    return surface->m_data.pLS;
+}
+
+static void injectLayerGlassIntoPass() {
+    const auto& config = g_pGlobalState->config;
+    if (!config.layersEnabled || !**config.layersEnabled || g_pHyprRenderer->m_bRenderingSnapshot)
+        return;
+
+    pruneDeadLayerStates();
+
+    auto& elements = g_pHyprRenderer->m_renderPass.*privateMember(SPassElementsTag{});
+    using SElementData = std::remove_reference_t<decltype(elements)>::value_type;
+
+    for (size_t i = 0; i < elements.size(); ++i) {
+        const PHLLS layerSurface = layerOfElement(elements[i].element);
+        if (!layerSurface || !layerSurface->m_mapped || !shouldGlassLayer(layerSurface))
+            continue;
+
+        // renderLayer() queues a layer's main surface and subsurfaces back to back.
+        size_t end = i + 1;
+        while (end < elements.size() && layerOfElement(elements[end].element) == layerSurface)
+            ++end;
+
+        const float alpha = layerSurface->alpha().getTotal();
+        if (alpha < 0.001f) {
+            i = end - 1;
+            continue;
+        }
+
+        auto it = layerStateFor(layerSurface);
+        CGlassLayerCompositeElement::SGlassLayerCompositeData postData{it->second, alpha};
+        CGlassLayerPassElement::SGlassLayerPassData            preData{it->second, alpha};
+        elements.insert(elements.begin() + end, SElementData{.element = makeUnique<CGlassLayerCompositeElement>(postData)});
+        elements.insert(elements.begin() + i, SElementData{.element = makeUnique<CGlassLayerPassElement>(preData)});
+        it->second->damageIfMoved();
+
+        // Skip the pre element, the layer's surfaces and the post element.
+        i = end + 1;
+    }
+}
